+/* Register page select. Every register below 0xE0 means something different
+ * per page, so the page is state the replay loop has to track.
+ */
+#define JD9365_CMD_PAGE  0xE0
+#define JD9365_PAGE_USER 0x00
+
+/* Lane count lives in a user-page register, encoded rather than counted. */
+#define JD9365_CMD_DSI_INT0 0x80
+#define JD9365_DSI_1_LANE   0x00
+#define JD9365_DSI_2_LANE   0x01
+#define JD9365_DSI_3_LANE   0x10
+#define JD9365_DSI_4_LANE   0x11
+
+#define JD9365_MADCTL_BGR BIT(3)
+
+/* Waveshare's DSI panel boards put reset and backlight behind a small MCU on
+ * the shared I2C bus rather than on GPIOs -- the DSI FPC carries the lanes,
+ * power and I2C, and nothing else. Same 0x45 address as the ICN6211 boards
+ * driven by waveshare,dsi2dpi, but a different register map, so it cannot be
+ * that driver.
+ *
+ * 0x95 sequences panel power, 0x96 is backlight brightness. The values are
+ * the vendor's; only 0x96 has an obvious meaning (0x00 dark, 0xFF full).
+ */
+#define JD9365_CARRIER_POWER     0x95
+#define JD9365_CARRIER_POWER_1   0x11
+#define JD9365_CARRIER_POWER_2   0x17
+#define JD9365_CARRIER_BACKLIGHT 0x96
+#define JD9365_CARRIER_BL_OFF    0x00
+#define JD9365_CARRIER_BL_ON     0xFF
+
+/* COLMOD (0x3A) values, by bits per pixel. */
+#define JD9365_COLMOD_16BPP 0x55
+#define JD9365_COLMOD_18BPP 0x66
+#define JD9365_COLMOD_24BPP 0x77
