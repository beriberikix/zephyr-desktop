+
+struct jd9365_config {
+	const struct device *mipi_dsi;
+	const struct gpio_dt_spec reset_gpio;
+	const struct gpio_dt_spec bl_gpio;
+	uint8_t num_of_lanes;
+	uint8_t pixel_format;
+	uint16_t panel_width;
+	uint16_t panel_height;
+	uint8_t channel;
+	bool bgr;
+	const struct device *carrier_bus;
+	uint16_t carrier_addr;
+	uint32_t hbp;
+	uint32_t hsync;
+	uint32_t hfp;
+	uint32_t vbp;
+	uint32_t vsync;
+	uint32_t vfp;
+};
+
+static int jd9365_carrier_write(const struct device *dev, uint8_t reg, uint8_t val)
+{
+	const struct jd9365_config *config = dev->config;
+	uint8_t buf[2] = {reg, val};
+
+	return i2c_write(config->carrier_bus, buf, sizeof(buf), config->carrier_addr);
+}
+
+static int jd9365_set_backlight(const struct device *dev, bool on)
+{
+	const struct jd9365_config *config = dev->config;
+
+	if (config->carrier_bus != NULL) {
+		return jd9365_carrier_write(dev, JD9365_CARRIER_BACKLIGHT,
+					    on ? JD9365_CARRIER_BL_ON : JD9365_CARRIER_BL_OFF);
+	}
+	if (config->bl_gpio.port != NULL) {
+		return gpio_pin_set_dt(&config->bl_gpio, on ? 1 : 0);
+	}
+	return 0;
+}
+
+static int jd9365_blanking_off(const struct device *dev)
+{
+	return jd9365_set_backlight(dev, true);
+}
+
+static int jd9365_blanking_on(const struct device *dev)
+{
+	return jd9365_set_backlight(dev, false);
+}
+
+/* The devicetree carries the MIPI DSI pixel format, which the display API
+ * reports under its own enumeration.
+ */
+static enum display_pixel_format jd9365_display_format(uint8_t pixfmt)
+{
+	switch (pixfmt) {
+	case MIPI_DSI_PIXFMT_RGB565:
+		return PIXEL_FORMAT_RGB_565;
+	case MIPI_DSI_PIXFMT_RGB888:
+	default:
+		return PIXEL_FORMAT_RGB_888;
+	}
+}
+
+static int jd9365_colmod(uint8_t pixfmt, uint8_t *colmod)
+{
+	switch (pixfmt) {
+	case MIPI_DSI_PIXFMT_RGB565:
+		*colmod = JD9365_COLMOD_16BPP;
+		return 0;
+	case MIPI_DSI_PIXFMT_RGB666:
+	case MIPI_DSI_PIXFMT_RGB666_PACKED:
+		*colmod = JD9365_COLMOD_18BPP;
+		return 0;
+	case MIPI_DSI_PIXFMT_RGB888:
+		*colmod = JD9365_COLMOD_24BPP;
+		return 0;
+	default:
+		return -ENOTSUP;
+	}
+}
+
+static int jd9365_lane_code(uint8_t lanes, uint8_t *code)
+{
+	switch (lanes) {
+	case 1:
+		*code = JD9365_DSI_1_LANE;
+		return 0;
+	case 2:
+		*code = JD9365_DSI_2_LANE;
+		return 0;
+	case 3:
+		*code = JD9365_DSI_3_LANE;
+		return 0;
+	case 4:
+		*code = JD9365_DSI_4_LANE;
+		return 0;
+	default:
+		return -ENOTSUP;
+	}
+}
+
+static void jd9365_get_capabilities(const struct device *dev,
+				    struct display_capabilities *capabilities)
+{
+	const struct jd9365_config *config = dev->config;
+	enum display_pixel_format format = jd9365_display_format(config->pixel_format);
+
+	memset(capabilities, 0, sizeof(struct display_capabilities));
+	capabilities->x_resolution = config->panel_width;
+	capabilities->y_resolution = config->panel_height;
+	capabilities->supported_pixel_formats = format;
+	capabilities->current_pixel_format = format;
+	capabilities->current_orientation = DISPLAY_ORIENTATION_NORMAL;
+}
+
+static int jd9365_set_pixel_format(const struct device *dev,
+				   const enum display_pixel_format pixel_format)
+{
+	const struct jd9365_config *config = dev->config;
+
+	if (pixel_format == jd9365_display_format(config->pixel_format)) {
+		return 0;
+	}
+
+	return -ENOTSUP;
+}
+
+/* The panel has no transpose: MADCTL on JD9365 carries GS/SS mirror bits but
+ * no exchange bit, so a rotated desktop has to be rotated by whoever draws it.
+ */
+static int jd9365_set_orientation(const struct device *dev,
+				  const enum display_orientation orientation)
+{
+	if (orientation == DISPLAY_ORIENTATION_NORMAL) {
+		return 0;
+	}
+	return -ENOTSUP;
+}
+
+static DEVICE_API(display, jd9365_api) = {
+	.blanking_on = jd9365_blanking_on,
+	.blanking_off = jd9365_blanking_off,
+	.get_capabilities = jd9365_get_capabilities,
+	.set_pixel_format = jd9365_set_pixel_format,
+	.set_orientation = jd9365_set_orientation,
+};
+
+static int jd9365_dcs(const struct device *dev, uint8_t cmd, uint8_t data, uint8_t len)
+{
+	const struct jd9365_config *config = dev->config;
+
+	return mipi_dsi_dcs_write(config->mipi_dsi, config->channel, cmd, &data, len);
+}
+
+static int jd9365_init(const struct device *dev)
+{
+	const struct jd9365_config *config = dev->config;
+	struct mipi_dsi_device mdev;
+	uint8_t lane_code;
+	uint8_t colmod;
+	uint8_t page = JD9365_PAGE_USER;
+	uint8_t id[3];
+	int ret;
+
+	if (!device_is_ready(config->mipi_dsi)) {
+		LOG_ERR("MIPI DSI host not ready");
+		return -ENODEV;
+	}
+
+	ret = jd9365_lane_code(config->num_of_lanes, &lane_code);
+	if (ret < 0) {
+		LOG_ERR("Unsupported lane count %u", config->num_of_lanes);
+		return ret;
+	}
+
+	ret = jd9365_colmod(config->pixel_format, &colmod);
+	if (ret < 0) {
+		LOG_ERR("Unsupported pixel format %u", config->pixel_format);
+		return ret;
+	}
+
+	if (config->carrier_bus != NULL) {
+		if (!device_is_ready(config->carrier_bus)) {
+			LOG_ERR("Panel carrier I2C bus not ready");
+			return -ENODEV;
+		}
+
+		/* Power the panel, then bring the backlight up from dark. The
+		 * long settle afterwards is the vendor's, and the panel does
+		 * not answer its ID read without it.
+		 */
+		ret = jd9365_carrier_write(dev, JD9365_CARRIER_POWER, JD9365_CARRIER_POWER_1);
+		if (ret == 0) {
+			ret = jd9365_carrier_write(dev, JD9365_CARRIER_POWER,
+						   JD9365_CARRIER_POWER_2);
+		}
+		if (ret == 0) {
+			ret = jd9365_carrier_write(dev, JD9365_CARRIER_BACKLIGHT,
+						   JD9365_CARRIER_BL_OFF);
+		}
+		if (ret < 0) {
+			LOG_ERR("Panel carrier at 0x%02x did not answer (%d)", config->carrier_addr,
+				ret);
+			return ret;
+		}
+		k_msleep(100);
+
+		ret = jd9365_carrier_write(dev, JD9365_CARRIER_BACKLIGHT, JD9365_CARRIER_BL_ON);
+		if (ret < 0) {
+			LOG_ERR("Failed to raise backlight (%d)", ret);
+			return ret;
+		}
+		k_msleep(1000);
+	}
+
+	if (config->reset_gpio.port != NULL) {
+		ret = gpio_pin_configure_dt(&config->reset_gpio, GPIO_OUTPUT_ACTIVE);
+		if (ret < 0) {
+			LOG_ERR("Failed to configure reset GPIO (%d)", ret);
+			return ret;
+		}
+		k_msleep(10);
+		gpio_pin_set_dt(&config->reset_gpio, 0);
+		k_msleep(50);
+	} else {
+		/* No reset line -- the Waveshare FPC does not carry one. The
+		 * vendor falls back to a DCS soft reset, so do the same.
+		 */
+		ret = mipi_dsi_dcs_write(config->mipi_dsi, config->channel, MIPI_DCS_SOFT_RESET,
+					 NULL, 0);
+		if (ret < 0) {
+			LOG_DBG("Soft reset failed (%d); continuing", ret);
+		}
+		k_msleep(120);
+	}
+
+	if (config->carrier_bus == NULL && config->bl_gpio.port != NULL) {
+		ret = gpio_pin_configure_dt(&config->bl_gpio, GPIO_OUTPUT_ACTIVE);
+		if (ret < 0) {
+			LOG_ERR("Failed to configure backlight GPIO (%d)", ret);
+			return ret;
+		}
+	}
+
+	/* Not load-bearing, but it is the one cheap way to tell "the link is up
+	 * and the panel is answering" from "nothing is there" during bring-up.
+	 * A Waveshare 10.1-DSI-TOUCH-A answers 93 65 04, observed on the stock
+	 * ESP-IDF firmware -- so this is a check with a known answer, not just
+	 * a log line. It is not enforced: another JD9365 module may differ.
+	 */
+	ret = mipi_dsi_dcs_read(config->mipi_dsi, config->channel, 0x04, id, sizeof(id));
+	if (ret < 0) {
+		LOG_DBG("Panel ID read failed (%d); continuing", ret);
+	} else {
+		LOG_DBG("Panel ID: %02X %02X %02X", id[0], id[1], id[2]);
+	}
+
+	ret = jd9365_dcs(dev, JD9365_CMD_PAGE, JD9365_PAGE_USER, 1);
+	if (ret < 0) {
+		LOG_ERR("Failed to select user page (%d)", ret);
+		return ret;
+	}
+
+	ret = jd9365_dcs(dev, MIPI_DCS_SET_ADDRESS_MODE, config->bgr ? JD9365_MADCTL_BGR : 0, 1);
+	if (ret < 0) {
+		LOG_ERR("Failed to set address mode (%d)", ret);
+		return ret;
+	}
+
+	ret = jd9365_dcs(dev, MIPI_DCS_SET_PIXEL_FORMAT, colmod, 1);
+	if (ret < 0) {
+		LOG_ERR("Failed to set pixel format (%d)", ret);
+		return ret;
+	}
+
+	ret = jd9365_dcs(dev, JD9365_CMD_DSI_INT0, lane_code, 1);
+	if (ret < 0) {
+		LOG_ERR("Failed to set lane count (%d)", ret);
+		return ret;
+	}
+
+	for (size_t i = 0; i < ARRAY_SIZE(jd9365_init_cmds); i++) {
+		const struct jd9365_init_cmd *c = &jd9365_init_cmds[i];
+		uint8_t data = c->data;
+
+		/* The table was captured from a 2-lane panel and hardcodes the
+		 * lane register. Honour the devicetree instead, so data-lanes
+		 * is not a property that silently does nothing.
+		 */
+		if (page == JD9365_PAGE_USER && c->cmd == JD9365_CMD_DSI_INT0) {
+			data = lane_code;
+		}
+
+		ret = mipi_dsi_dcs_write(config->mipi_dsi, config->channel, c->cmd, &data, c->len);
+		if (ret < 0) {
+			LOG_ERR("Panel init command 0x%02x failed (%d)", c->cmd, ret);
+			return ret;
+		}
+
+		if (c->cmd == JD9365_CMD_PAGE && c->len > 0) {
+			page = c->data;
+		}
+
+		if (c->delay_ms > 0) {
+			k_msleep(c->delay_ms);
+		}
+	}
+
+	mdev.pixfmt = config->pixel_format;
+	mdev.data_lanes = config->num_of_lanes;
+	mdev.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST;
+	mdev.timings.hactive = config->panel_width;
+	mdev.timings.hfp = config->hfp;
+	mdev.timings.hbp = config->hbp;
+	mdev.timings.hsync = config->hsync;
+	mdev.timings.vactive = config->panel_height;
+	mdev.timings.vfp = config->vfp;
+	mdev.timings.vbp = config->vbp;
+	mdev.timings.vsync = config->vsync;
+
+	ret = mipi_dsi_attach(config->mipi_dsi, config->channel, &mdev);
+	if (ret < 0) {
+		LOG_ERR("Failed to attach to MIPI DSI host (%d)", ret);
+		return ret;
+	}
+
+	LOG_INF("JD9365 panel initialized (%ux%u, %u lanes)", config->panel_width,
+		config->panel_height, config->num_of_lanes);
+
+	return 0;
+}
+
+#define JD9365_PANEL(id)                                                                           \
+	static const struct jd9365_config jd9365_config_##id = {                                   \
+		.mipi_dsi = DEVICE_DT_GET(DT_INST_BUS(id)),                                        \
+		.reset_gpio = GPIO_DT_SPEC_INST_GET_OR(id, reset_gpios, {0}),                      \
+		.bl_gpio = GPIO_DT_SPEC_INST_GET_OR(id, bl_gpios, {0}),                            \
+		.num_of_lanes = DT_INST_PROP_BY_IDX(id, data_lanes, 0),                            \
+		.pixel_format = DT_INST_PROP(id, pixel_format),                                    \
+		.panel_width = DT_INST_PROP(id, width),                                            \
+		.panel_height = DT_INST_PROP(id, height),                                          \
+		.channel = DT_INST_REG_ADDR(id),                                                   \
+		.bgr = DT_INST_PROP(id, bgr),                                                      \
+		.carrier_bus = DEVICE_DT_GET_OR_NULL(DT_INST_PHANDLE(id, carrier_i2c)),            \
+		.carrier_addr = DT_INST_PROP_OR(id, carrier_address, 0x45),                                                      \
+		.hbp = DT_PROP(DT_INST_CHILD(id, display_timings), hback_porch),                   \
+		.hsync = DT_PROP(DT_INST_CHILD(id, display_timings), hsync_len),                   \
+		.hfp = DT_PROP(DT_INST_CHILD(id, display_timings), hfront_porch),                  \
+		.vbp = DT_PROP(DT_INST_CHILD(id, display_timings), vback_porch),                   \
+		.vsync = DT_PROP(DT_INST_CHILD(id, display_timings), vsync_len),                   \
+		.vfp = DT_PROP(DT_INST_CHILD(id, display_timings), vfront_porch),                  \
+	};                                                                                         \
+	DEVICE_DT_INST_DEFINE(id, jd9365_init, NULL, NULL, &jd9365_config_##id, POST_KERNEL,       \
+			      CONFIG_DISPLAY_JD9365_INIT_PRIORITY, &jd9365_api);
+
+DT_INST_FOREACH_STATUS_OKAY(JD9365_PANEL)
