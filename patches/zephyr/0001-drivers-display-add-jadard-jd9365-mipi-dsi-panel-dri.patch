@@ -0,0 +1,47 @@
+#
+# Copyright (c) 2026 Jonathan Beri
+#
+# SPDX-License-Identifier: Apache-2.0
+#
+
+description: |
+  Jadard JD9365 MIPI-DSI panel controller.
+
+  The driver carries the vendor initialisation sequence for the Waveshare
+  10.1in 800x1280 2-lane module. The panel is natively portrait and has no
+  transpose bit, so set-orientation only accepts DISPLAY_ORIENTATION_NORMAL.
+
+compatible: "jadard,jd9365"
+
+include: [mipi-dsi-device.yaml, display-controller.yaml]
+
+properties:
+  reset-gpios:
+    type: phandle-array
+    description: |
+      Reset GPIO pin (active low).
+
+  bl-gpios:
+    type: phandle-array
+    description: |
+      Backlight control GPIO pin (active high).
+
+  bgr:
+    type: boolean
+    description: |
+      Set the MADCTL BGR bit, for modules wired with the colour components
+      in reverse order.
+
+  carrier-i2c:
+    type: phandle
+    description: |
+      I2C controller the panel board's own MCU sits on. Waveshare's DSI FPC
+      carries the lanes, power and I2C and no control lines at all, so on
+      those modules reset and backlight are register writes rather than
+      GPIOs. Omit for a module wired with reset-gpios/bl-gpios instead.
+
+  carrier-address:
+    type: int
+    default: 0x45
+    description: |
+      I2C address of that MCU. Only meaningful with carrier-i2c.
