--- /dev/null
+++ b/boards/waveshare/esp32p4_module_dev_kit/Kconfig.defconfig
@@ -0,0 +1,21 @@
+# Copyright (c) 2026 Jonathan Beri
+#
+# SPDX-License-Identifier: Apache-2.0
+
+if BOARD_ESP32P4_MODULE_DEV_KIT_ESP32P4_HPCORE
+
+config NET_L2_ETHERNET
+	default y if DT_HAS_ESPRESSIF_ESP32_ETH_ENABLED
+
+# The panel FPC has no touch interrupt line, so the GT911 has to be polled.
+config INPUT_GT911_INTERRUPT
+	default n
+
+# The DSI scanout controller allocates its framebuffers from the external
+# heap: 800*1280*3 is 3,072,000 bytes and it wants two of them. The module
+# carries 32 MB of PSRAM, so this is not tight, but the default is far too
+# small and the failure is a runtime -ENOMEM out of a build that succeeded.
+config ESP_SPIRAM_HEAP_SIZE
+	default 16777216 if DISPLAY
+
+endif # BOARD_ESP32P4_MODULE_DEV_KIT_ESP32P4_HPCORE
