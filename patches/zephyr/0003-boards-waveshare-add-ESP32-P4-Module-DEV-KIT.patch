diff --git a/boards/waveshare/esp32p4_module_dev_kit/esp32p4_module_dev_kit_esp32p4_hpcore-pinctrl.dtsi b/boards/waveshare/esp32p4_module_dev_kit/esp32p4_module_dev_kit_esp32p4_hpcore-pinctrl.dtsi
new file mode 100644
index 000000000..baee7c1e1
--- /dev/null
+++ b/boards/waveshare/esp32p4_module_dev_kit/esp32p4_module_dev_kit_esp32p4_hpcore-pinctrl.dtsi
@@ -0,0 +1,62 @@
+/*
+ * Copyright (c) 2026 Jonathan Beri
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/dt-bindings/pinctrl/esp-pinctrl-common.h>
+#include <zephyr/dt-bindings/pinctrl/esp32p4-pinctrl.h>
+#include <zephyr/dt-bindings/pinctrl/esp32p4-gpio-sigmap.h>
+
+&pinctrl {
+	uart0_default: uart0_default {
+		group1 {
+			pinmux = <UART0_TX_GPIO37>;
+			output-high;
+		};
+
+		group2 {
+			pinmux = <UART0_RX_GPIO38>;
+			bias-pull-up;
+		};
+	};
+
+	i2c0_default: i2c0_default {
+		group1 {
+			pinmux = <I2C0_SDA_GPIO7>,
+				 <I2C0_SCL_GPIO8>;
+			bias-pull-up;
+			drive-open-drain;
+			output-high;
+		};
+	};
+
+	i2s0_default: i2s0_default {
+		group1 {
+			pinmux = <I2S0_MCLK_GPIO13>,
+				 <I2S0_O_BCK_GPIO12>,
+				 <I2S0_O_WS_GPIO10>,
+				 <I2S0_I_SD_GPIO11>,
+				 <I2S0_O_SD_GPIO9>;
+		};
+	};
+
+	mdio_default: mdio_default {
+		group1 {
+			pinmux = <SMI_MDC_GPIO31>,
+				 <SMI_MDIO_GPIO52>;
+		};
+	};
+
+	rmii_default: rmii_default {
+		group1 {
+			pinmux = <RMII_CLK_GPIO50>,
+				 <RMII_TX_EN_GPIO49>,
+				 <RMII_TXD0_GPIO34>,
+				 <RMII_TXD1_GPIO35>,
+				 <RMII_CRS_DV_GPIO28>,
+				 <RMII_RXD0_GPIO29>,
+				 <RMII_RXD1_GPIO30>;
+		};
+	};
+};
diff --git a/boards/waveshare/esp32p4_module_dev_kit/esp32p4_module_dev_kit_esp32p4_hpcore.dts b/boards/waveshare/esp32p4_module_dev_kit/esp32p4_module_dev_kit_esp32p4_hpcore.dts
new file mode 100644
index 000000000..536370560
--- /dev/null
+++ b/boards/waveshare/esp32p4_module_dev_kit/esp32p4_module_dev_kit_esp32p4_hpcore.dts
@@ -0,0 +1,279 @@
+/*
+ * Copyright (c) 2026 Jonathan Beri
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/dts-v1/;
+
+#include <espressif/esp32p4/esp32p4_n16r32.dtsi>
+#include "esp32p4_module_dev_kit_esp32p4_hpcore-pinctrl.dtsi"
+#include <zephyr/dt-bindings/input/input-event-codes.h>
+#include <espressif/partitions_0x2000_default_16M.dtsi>
+#include <zephyr/dt-bindings/display/panel.h>
+#include <zephyr/dt-bindings/mipi_dsi/mipi_dsi.h>
+
+/ {
+	model = "Waveshare ESP32-P4-Module-DEV-KIT HP Core";
+	compatible = "espressif,esp32p4";
+
+	chosen {
+		zephyr,sram = &sramhp;
+		zephyr,console = &uart0;
+		zephyr,shell-uart = &uart0;
+		zephyr,flash = &flash0;
+		zephyr,code-partition = &slot0_partition;
+		zephyr,display = &dsi_display;
+		zephyr,touch = &gt911;
+	};
+
+	aliases {
+		sdhc0 = &sdhc0;
+		sw0 = &boot_button;
+		watchdog0 = &wdt0;
+	};
+
+	gpio_keys {
+		compatible = "gpio-keys";
+
+		boot_button: button {
+			label = "Boot Button";
+			gpios = <&gpio1 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
+			zephyr,code = <INPUT_KEY_0>;
+		};
+	};
+};
+
+/* v1.3 silicon */
+&cpu0 {
+	clock-frequency = <DT_FREQ_M(360)>;
+};
+
+&cpu1 {
+	clock-frequency = <DT_FREQ_M(360)>;
+};
+
+&uart0 {
+	status = "okay";
+	current-speed = <115200>;
+	pinctrl-0 = <&uart0_default>;
+	pinctrl-names = "default";
+};
+
+&i2c0 {
+	status = "okay";
+	clock-frequency = <I2C_BITRATE_FAST>;
+	pinctrl-0 = <&i2c0_default>;
+	pinctrl-names = "default";
+
+	/* Shared with the ES8311 codec and both the CSI and DSI connectors. */
+
+	gt911: touch-controller@5d {
+		compatible = "goodix,gt911";
+		status = "okay";
+		reg = <0x5d>;
+		screen-width = <800>;
+		screen-height = <1280>;
+		/* The 22-pin DSI FPC carries 3V3, I2C and the MIPI lanes and
+		 * nothing else, so there is no interrupt and no reset line to
+		 * give this. Polled, and the address-select dance is skipped.
+		 */
+	};
+};
+
+/* ES8311 codec, speaker PA on GPIO53, and the on-board microphone. */
+&i2s0 {
+	status = "okay";
+	unit = <0>;
+	pinctrl-0 = <&i2s0_default>;
+	pinctrl-names = "default";
+};
+
+&spi2 {
+	status = "disabled";
+};
+
+&trng0 {
+	status = "okay";
+};
+
+&coretemp {
+	status = "okay";
+};
+
+&gpio0 {
+	status = "okay";
+};
+
+&gpio1 {
+	status = "okay";
+};
+
+&wdt0 {
+	status = "okay";
+};
+
+&dma {
+	status = "okay";
+};
+
+&dma_axi {
+	status = "okay";
+};
+
+zephyr_udc0: &usb_otg {
+	status = "okay";
+};
+
+&usb_serial {
+	status = "okay";
+	current-speed = <115200>;
+};
+
+&sdhc {
+	sdhc0: sdhc@0 {
+		status = "okay";
+		bus-width = <4>;
+		max-bus-freq = <40000000>;
+		/* GPIO45: SD card power enable (active-low) */
+		pwr-gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;
+		clk-pin = <43>;
+		cmd-pin = <44>;
+		d0-pin = <39>;
+		d1-pin = <40>;
+		d2-pin = <41>;
+		d3-pin = <42>;
+
+		mmc {
+			compatible = "zephyr,sdmmc-disk";
+			disk-name = "SD";
+			status = "okay";
+		};
+	};
+
+	/* ESP32-C6 wireless co-processor over SDIO (kept disabled until
+	 * there is a driver binding for it; pins follow the schematic:
+	 * clk=18, cmd=19, d0-d3=14-17, with 51K pull-ups on the C6 side, and
+	 * the C6 held in reset by GPIO54). Confirmed against this board's own
+	 * ESP-IDF factory firmware, which prints exactly these pins.
+	 *
+	 * Zephyr's esp_hosted driver is SPI-only, so there is nothing to bind
+	 * to it yet -- this records the wiring, it does not enable Wi-Fi.
+	 */
+	sdhc1: sdhc@1 {
+		status = "disabled";
+		bus-width = <4>;
+		clk-pin = <18>;
+		cmd-pin = <19>;
+		d0-pin = <14>;
+		d1-pin = <15>;
+		d2-pin = <16>;
+		d3-pin = <17>;
+	};
+};
+
+&ldo {
+	status = "okay";
+
+	ldo1@1 {
+		reg = <1>;
+		regulator-name = "ldo1";
+		regulator-init-microvolt = <3300000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	ldo2@2 {
+		reg = <2>;
+		regulator-name = "ldo2";
+		regulator-init-microvolt = <1800000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	ldo3@3 {
+		reg = <3>;
+		regulator-name = "ldo3";
+		regulator-init-microvolt = <2500000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	ldo4@4 {
+		reg = <4>;
+		regulator-name = "ldo4";
+		regulator-init-microvolt = <3300000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+};
+
+&mdio {
+	pinctrl-0 = <&mdio_default>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	phy: ethernet-phy@1 {
+		compatible = "ethernet-phy";
+		reg = <1>;
+		/* GPIO51: PHY reset (active-low) */
+		reset-gpios = <&gpio1 19 GPIO_ACTIVE_LOW>;
+		reset-assert-duration-us = <10000>;
+		reset-deassertion-timeout-ms = <100>;
+	};
+};
+
+&eth {
+	status = "okay";
+	phy-handle = <&phy>;
+	pinctrl-0 = <&rmii_default>;
+	pinctrl-names = "default";
+};
+
+/*
+ * The 10.1in Waveshare DSI panel the DEV-KIT-C ships with: JD9365, 800x1280
+ * portrait, 2 lanes. Timings and clocks are the vendor's own
+ * (JD9365_800_1280_PANEL_60HZ_DPI_CONFIG): 80 MHz DPI pixel clock, which
+ * divides the P4's fixed 240 MHz source exactly, and a 1500 Mbps lane rate.
+ *
+ * Reset and backlight are I2C registers on the panel board's own MCU rather
+ * than GPIOs -- see the carrier-i2c property and the driver.
+ */
+&mipi_dsi {
+	status = "okay";
+	phy-clock = <1500000000>;
+	dpi-clock-frequency = <80000000>;
+
+	jd9365: panel-controller@0 {
+		compatible = "jadard,jd9365";
+		reg = <0>;
+		status = "okay";
+		data-lanes = <2>;
+		pixel-format = <MIPI_DSI_PIXFMT_RGB888>;
+		width = <800>;
+		height = <1280>;
+		carrier-i2c = <&i2c0>;
+		carrier-address = <0x45>;
+
+		display-timings {
+			compatible = "zephyr,panel-timing";
+			hsync-len = <20>;
+			hback-porch = <20>;
+			hfront-porch = <40>;
+			vsync-len = <4>;
+			vback-porch = <10>;
+			vfront-porch = <30>;
+			hsync-active = <0>;
+			vsync-active = <0>;
+			de-active = <1>;
+			pixelclk-active = <0>;
+		};
+	};
+};
+
+&dsi_display {
+	status = "okay";
+	pixel-format = <PANEL_PIXEL_FORMAT_RGB_888>;
+	width = <800>;
+	height = <1280>;
+};
