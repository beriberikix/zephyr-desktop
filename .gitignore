# west-managed trees — this repo is the workspace topdir as well as the project
# repo, so the upstream sources live here but are not ours to version.
/.west/
/zephyr/
/modules/

# build output
/build*/

# assembled release bundles -- tools/mkrelease.sh writes here
/release/

# session-local scratch
/.claude/

# vendor firmware read off the board before it was overwritten -- 14 MB,
# not ours to redistribute, and recoverable with esptool if it is ever needed
/factory-backup/
